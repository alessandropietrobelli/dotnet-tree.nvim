<Project>
  <!-- Chains to the repository-root file, then changes what Legacy needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <ItemGroup>
    <!-- Ids are matched ignoring case. -->
    <PackageVersion Update="serilog" Version="3.1.1" />
    <PackageVersion Include="Legacy.Only" Version="1.0.0" />
    <!-- Already defined by the imported file: a duplicate NuGet ignores. -->
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.0" />
    <PackageVersion Update="Never.Defined" Version="9.9.9" />
  </ItemGroup>
</Project>
