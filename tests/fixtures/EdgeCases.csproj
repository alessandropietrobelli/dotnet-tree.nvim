<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The comparison is escaped. Both this and the two below are valid XML:
         XML 1.0 section 2.4 forbids '<' and '&' in an attribute value, not '>'. -->
    <ProjectReference Condition=" '$(N)' &gt; '1' " Include="../Escaped/Escaped.csproj" />

    <!-- A literal '>', which is valid XML and which MSBuild builds without a
         warning. The reader tracks quoting, so the tag ends where it really
         ends and both attribute orders read the same. -->
    <ProjectReference Include="../GtAfter/GtAfter.csproj" Condition=" '$(N)' > '1' " />

    <!-- Same construct, opposite attribute order. This one used to be dropped
         with no error, because the scan stopped at the '>' before reaching the
         Include: silent data loss on a file the toolchain accepts. -->
    <ProjectReference Condition=" '$(N)' > '1' " Include="../GtBefore/GtBefore.csproj" />

    <!-- Commented out: must not be reported as a real dependency. -->
    <!-- <ProjectReference Include="../Commented/Commented.csproj" /> -->

    <ProjectReference Include="../Live/Live.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODO: bring this back once the analyzer is fixed.
    <PackageReference Include="Commented.Package" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    -->
    <PackageReference Include="Live.Package" Version="2.0.0" />
    <!-- Both the Include and the Version sit behind a literal '>'. The whole
         package used to be invisible: the truncated tag carried no Include. -->
    <PackageReference Condition=" '$(N)' > '1' " Include="GtBefore.Package" Version="1.2.3" />
  </ItemGroup>

</Project>
