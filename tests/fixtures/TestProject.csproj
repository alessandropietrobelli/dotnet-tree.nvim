<Project Sdk="Microsoft.NET.Sdk">
  <!-- What `dotnet new xunit` produces on v3: an executable, because v3 runs
       each test assembly as its own process. OutputType alone cannot tell this
       apart from an application; the test SDK reference can. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="microsoft.net.test.sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="1.0.0" />
  </ItemGroup>
</Project>
