<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executable on two frameworks: the launcher has to ask which one, because
       bin/Debug/ holds two different assemblies and neither is the obvious one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>
</Project>
